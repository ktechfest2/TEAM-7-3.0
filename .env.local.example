# Supabase → Project Settings → API (the new "publishable"/"secret" keys work too)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Server only. Needed from milestone M4.
ANTHROPIC_API_KEY=

# Password for the seeded demo accounts (witness1@demo.countrack.test, …)
DEMO_PASSWORD=countrack-demo

# Optional: immutable Git commit SHA for the INEC polling-unit directory snapshot.
# Defaults to resolving the latest main commit when importing.
INEC_DATASET_REF=main

# M4: return cached extractions for known demo photos
DEMO_MODE=false
